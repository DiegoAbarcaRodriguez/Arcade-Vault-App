RESEND_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Auth (spec 10) ---
# El login con Google y GitHub NO usa variables de entorno en este proyecto.
# Los client id / client secret de cada proveedor OAuth se configuran en el
# dashboard de Supabase: Authentication > Providers > Google / GitHub.
# Ahí también hay que registrar las Redirect URLs de la app:
#   http://localhost:3000/auth/callback   (desarrollo)
#   https://<dominio-de-produccion>/auth/callback
# La confirmación de email por registro debe quedar ACTIVADA
# (Authentication > Providers > Email > "Confirm email").
